# Copy to terraform.tfvars (git-ignored) and replace every placeholder.
# terraform.tfvars contains real secrets and must never be committed.

project_id = "your-gcp-project-id"
region     = "us-central1"

repository_id = "record-over-rhetoric"
service_name  = "record-over-rhetoric"
client_origin = "https://recordoverrhetoric.app"
custom_domain = "www.recordoverrhetoric.app"

min_instances = 0
max_instances = 3

# Leave empty to build the image reference from region/project/repo/service.
container_image = ""

# --- Secrets ---------------------------------------------------------------
# Paste your Atlas SRV URI here (or manage it through Secret Manager).
mongodb_uri        = ""
jwt_secret         = "replace-with-a-long-random-string-at-least-32-chars"
openrouter_api_key = "sk-or-v1-replace-me"

smtp_host = "smtp.example.com"
smtp_port = "587"
smtp_user = "replace-me"
smtp_pass = "replace-me"
mail_from = "Record Over Rhetoric <no-reply@recordoverrhetoric.app>"
