# Server environment
PORT=8080
NODE_ENV=development

# MongoDB. Leave blank to use the local Docker Mongo started by scripts/setup.sh.
# For Atlas, paste your full SRV connection string from the Atlas Connect dialog.
MONGODB_URI=

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# OpenRouter AI panel
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL_MINIMAX=minimax/minimax-m3.1-flash
AI_MODEL_DEEPSEEK=deepseek/deepseek-v4.1-flash
AI_MODEL_GROK=x-ai/grok-4.3
AI_ENABLED=true
AI_FAKE=false
AI_TIMEOUT_MS=75000

# Real data import (optional). Free key: https://api.congress.gov/sign-up/
# Voteview roll-call CSVs are used for member positions (no key needed).
CONGRESS_API_KEY=
# Optional: writable cache directory for importer downloads (default: server/.cache)
IMPORT_CACHE_DIR=

# Transactional e-mail (leave blank to log e-mails to the console).
# Local Mailpit: SMTP_HOST=127.0.0.1, SMTP_PORT=1025 (see docs/EMAIL_SETUP.md).
# Gmail: smtp.gmail.com, 587, an App Password as SMTP_PASS.
# Resend: smtp.resend.com, 587, SMTP_USER=resend, SMTP_PASS=API key.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Record Over Rhetoric <no-reply@recordoverrhetoric.app>

# Seed the verified demo account demo@recordoverrhetoric.app / CompareVotes!2026
SEED_DEMO_USER=true
